# ResilientMesh environment template.
#
# Copy to .env and fill in only what you need. THIS FILE CONTAINS NO REAL
# VALUES and must never contain any: it is committed, .env is not.
#
# Every variable is optional. With an empty environment the stack boots in
# `managed` mode: PostgreSQL and Redis run inside the process, all credentials
# are minted from crypto/rand at startup, and no network egress is required.
#   go run ./cmd/mesh
#
# Durations accept Go syntax (300s, 5m, 1h) or a bare integer count of seconds.
# Booleans accept true/false, 1/0, yes/no, on/off.
# Every value is trimmed, length-bounded, and rejected if it contains control
# characters. Invalid values fail startup; they are never silently defaulted.


# ---------------------------------------------------------------------------
# Infrastructure mode
# ---------------------------------------------------------------------------

# managed  - embedded PostgreSQL + in-process Redis, credentials auto-generated.
#            The zero-dependency demo path. No Docker, no system services.
# external - operator-supplied PostgreSQL and Redis. In this mode
#            MESH_WEBHOOK_SECRET, MESH_PG_DSN and MESH_OPS_TOKEN are REQUIRED;
#            startup fails rather than run with an unauthenticated ops console
#            or a webhook edge that cannot verify a signature.
# Default: managed
MESH_INFRA_MODE=managed


# ---------------------------------------------------------------------------
# HTTP edge
# ---------------------------------------------------------------------------

# Listen address for the API, ops console, and SSE endpoints.
# Default: 127.0.0.1:8080 — loopback only. Binding every interface would expose
# an operator console and a webhook endpoint to the local network on a laptop,
# and would make a firewall prompt part of the first-run experience. Set
# 0.0.0.0:8080 deliberately when you actually want that.
MESH_HTTP_ADDR=127.0.0.1:8080

# Bearer token guarding /api/v1/ops/*. Compared in constant time.
# Required in external mode. Auto-generated in managed mode and printed as a
# fingerprint plus the usable value in the startup banner.
# Generate one with: openssl rand -hex 32
MESH_OPS_TOKEN=


# ---------------------------------------------------------------------------
# Backing services
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Both libpq forms are accepted:
#   postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#   host=HOST port=5432 user=USER password=PASSWORD dbname=DBNAME
# Required in external mode. Ignored in managed mode, which supplies its own.
# The password is stripped from every log line and from Config.String().
MESH_PG_DSN=

# Redis address as host:port. Ignored in managed mode.
# Default: 127.0.0.1:6379
MESH_REDIS_ADDR=127.0.0.1:6379


# ---------------------------------------------------------------------------
# Webhook trust boundary
# ---------------------------------------------------------------------------

# Shared secret for X-Razorpay-Signature (HMAC-SHA256 over the raw body).
# This is THE security boundary of the system: everything downstream trusts the
# payment amount because this signature verified.
# Required in external mode. Auto-generated (32 random bytes, hex) in managed
# mode so the bundled simulator and the ingest edge share one secret.
# Generate one with: openssl rand -hex 32
MESH_WEBHOOK_SECRET=

# Maximum accepted clock skew, in either direction, between the event's
# created_at and now. Bounds the window in which a captured delivery can be
# replayed. Range: 1s to 1h. Default: 300s
MESH_WEBHOOK_MAX_SKEW=300s


# ---------------------------------------------------------------------------
# Inference tier 1: live model (optional)
# ---------------------------------------------------------------------------

# none | groq | openai | gemini | ollama
# All of these speak the OpenAI /chat/completions format, so the provider only
# selects endpoint and model defaults. Default: none, meaning the live tier is
# skipped entirely and the stack runs offline on cassette replay plus the
# deterministic classifier. The system is fully functional with none.
MESH_LLM_PROVIDER=none

# GROQ FREE TIER: Groq issues free API keys that work against the
# OpenAI-compatible endpoint at https://api.groq.com/openai/v1 . Set
# MESH_LLM_PROVIDER=groq and paste the key below; the base URL and model
# defaults are filled in for you. Sign up at https://console.groq.com/keys .

# API key for the provider above. Leave empty for ollama (no bearer token) and
# for provider=none. NEVER commit a real key.
MESH_LLM_API_KEY=

# Override the endpoint. Empty means "use the provider default":
#   groq   -> https://api.groq.com/openai/v1
#   openai -> https://api.openai.com/v1
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai
#   ollama -> http://127.0.0.1:11434/v1
# Must be http or https.
MESH_LLM_BASE_URL=

# Override the model. Empty means "use the provider default":
#   groq -> llama-3.3-70b-versatile, openai -> gpt-4o-mini,
#   gemini -> gemini-2.0-flash, ollama -> llama3.1
MESH_LLM_MODEL=

# Per-call deadline for the live tier. Kept short on purpose: an incident that
# waits on a slow model is an incident that is not being recovered. On timeout
# the stack falls through to replay and then to the heuristic classifier.
# Range: 100ms to 2m. Default: 4s
MESH_LLM_TIMEOUT=4s


# ---------------------------------------------------------------------------
# Inference tier 2: cassette replay
# ---------------------------------------------------------------------------

# Directory of recorded, digest-keyed model responses. Makes benchmark runs
# deterministic and reproducible with no network. Default: testdata/cassettes
MESH_CASSETTE_DIR=testdata/cassettes


# ---------------------------------------------------------------------------
# Decision bounds
# ---------------------------------------------------------------------------

# Hard ceiling on recovery attempts per incident, enforced by the gatekeeper's
# STOP_RULE_MAX_ATTEMPTS invariant. Range: 1 to 10. Default: 3
MESH_MAX_ATTEMPTS=3

# Rolling success rate below which an issuer's circuit breaker opens.
# Range: 0.0 to 1.0. Default: 0.20
MESH_BREAKER_TRIP_RATE=0.20

# Minimum samples in the window before the trip rate is allowed to mean
# anything. Stops one failure in a quiet window declaring an outage.
# Range: 1 to 100000. Default: 10
MESH_BREAKER_MIN_SAMPLES=10

# How long an open breaker waits before admitting a probe.
# Range: 1s to 1h. Default: 60s
MESH_BREAKER_COOLDOWN=60s

# Width of the rolling per-issuer telemetry window.
# Range: 1s to 24h. Default: 5m
MESH_TELEMETRY_WINDOW=5m


# ---------------------------------------------------------------------------
# Runtime sizing
# ---------------------------------------------------------------------------

# Consumer goroutines in the worker pool, each with its own consumer name.
# Range: 1 to 256. Default: 4
MESH_WORKER_CONCURRENCY=4

# Hard cap on concurrent SSE sessions; requests past it get 503. An unbounded
# session map is a memory-exhaustion vector reachable by anyone who can open an
# EventSource. Range: 1 to 1000000. Default: 50000
MESH_MAX_SESSIONS=50000

# Lifetime of a checkout session, after which it can no longer be healed.
# Range: 1s to 24h. Default: 15m
MESH_SESSION_TTL=15m


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# debug | info | warn | error. Default: info
# Prompts and model responses are logged at debug only, and always through the
# redacting handler. Do not run debug against production traffic.
MESH_LOG_LEVEL=info


# ---------------------------------------------------------------------------
# Economics
# ---------------------------------------------------------------------------

# Path to the cost table shared with the Python evaluation harness. Both Go and
# Python read this one file so the live policy engine and the offline benchmark
# can never optimise different numbers. A missing file falls back to the
# compiled-in defaults; a malformed one is a hard startup error.
# Default: eval/costs.json
MESH_COST_MODEL_PATH=eval/costs.json


# ---------------------------------------------------------------------------
# Razorpay surface
# ---------------------------------------------------------------------------

# Listen address for the bundled razorpay-sim, which serves the real
# /v1/downtimes schema and signs real HMAC webhooks. Default: 127.0.0.1:8081
MESH_SIMULATOR_ADDR=127.0.0.1:8081

# Base URL the Razorpay client dials. Empty means "derive it from
# MESH_SIMULATOR_ADDR", so the simulator and the client cannot drift apart.
# Point it at https://api.razorpay.com/v1 to run against the real API.
MESH_RAZORPAY_BASE_URL=

# Razorpay API basic-auth credentials. Auto-generated in managed mode so the
# bundled simulator authenticates for real rather than accepting empty
# credentials. Only test-mode keys belong in a local .env, and no key of any
# kind belongs in this committed template.
MESH_RAZORPAY_KEY_ID=
MESH_RAZORPAY_KEY_SECRET=


# ---------------------------------------------------------------------------
# Demo
# ---------------------------------------------------------------------------

# Run the scripted outage timeline so a demo is repeatable to the frame.
# Default: false
MESH_DEMO_MODE=false

# Seed for every pseudo-random decision in the simulator, the chaos injector,
# and backoff jitter. Same seed, same run. Default: 42
MESH_SEED=42

# Compresses only the wall-clock wait before a scheduled retry, so a
# demonstration reaches an outcome instead of showing decisions and stopping.
# It never alters a decision: the gatekeeper's delays include regulatory floors
# such as RBI's 24-hour cooling window, and a system that could configure its
# way under one would have no invariant at all. The real delay and this factor
# are both written to the audit ledger, so a compressed run can never be
# mistaken for a production one. 1 means no compression.
# `go run ./cmd/mesh` overrides this with its -speed flag (default 60).
# Range: 1 to 10000. Default: 1
MESH_DEMO_TIME_SCALE=1
